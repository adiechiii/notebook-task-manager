{
  "openapi": "3.1.0",
  "info": {
    "title": "Mind OS Admin Intelligence Extensions API",
    "version": "1.0.0",
    "description": "Admin and intelligence extension actions for Mind OS. Keep separate from the stable daily Mind OS Action 1."
  },
  "servers": [
    {
      "url": "https://notebook-task-manager-admin.onrender.com"
    }
  ],
  "paths": {
    "/projects/update": {
      "post": {
        "operationId": "updateProject",
        "summary": "Update existing project metadata",
        "description": "Safely updates metadata for an existing project by exact project name. Does not create projects automatically and does not touch tasks, memories, or decisions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/memories/update": {
      "post": {
        "operationId": "updateMemory",
        "summary": "Update existing memory metadata",
        "description": "Safely updates metadata for an existing memory by exact memory_id. Does not create memories automatically and does not touch projects, tasks, or decisions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/decisions/update": {
      "post": {
        "operationId": "updateDecision",
        "summary": "Update existing decision metadata",
        "description": "Safely updates an existing decision by exact decision_id. Does not create decisions automatically and does not touch projects, tasks, or memories.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/tasks/bulk-update": {
      "post": {
        "operationId": "bulkUpdateTasks",
        "summary": "Bulk update existing tasks",
        "description": "Safely updates existing tasks by exact task_id. Supports status, priority, category, project, and page_date only. Does not create tasks and does not edit task text/title.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskBulkUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk task update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBulkUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/system/context-health": {
      "get": {
        "operationId": "getContextHealth",
        "summary": "Check Mind OS context health",
        "description": "Read-only health check for Mind OS sheets and context integrity. Checks sheet existence, headers, row counts, missing IDs, duplicate IDs, missing required fields, warnings, and recommendations. Does not write or modify any data.",
        "responses": {
          "200": {
            "description": "Context health result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/system/suggested-fixes": {
      "get": {
        "operationId": "getSuggestedFixes",
        "summary": "Get suggested Mind OS context fixes",
        "description": "Read-only suggested fixes based on context health. Does not apply fixes or modify any data.",
        "responses": {
          "200": {
            "description": "Suggested fixes result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestedFixesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/stale": {
      "get": {
        "operationId": "getStaleProjects",
        "summary": "Get stale projects",
        "description": "Read-only stale project detection. Returns Active and Paused projects that have not been updated for stale_after_days. Does not modify any data.",
        "parameters": [
          {
            "name": "stale_after_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1
            },
            "description": "Number of days since Updated At before a project is considered stale."
          }
        ],
        "responses": {
          "200": {
            "description": "Stale projects result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaleProjectsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/decisions/followups": {
      "get": {
        "operationId": "getDecisionFollowups",
        "summary": "Get follow-up decisions",
        "description": "Read-only decision follow-up review. Returns decisions with Status = Follow-up, optionally filtered by exact project and importance. Does not modify decisions, tasks, projects, or memories.",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            },
            "description": "Optional exact project name filter."
          },
          {
            "name": "importance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            },
            "description": "Optional exact importance filter, for example High, Medium, or Low."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Maximum number of follow-up decisions to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Follow-up decisions result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionFollowupsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
