{
  "openapi": "3.1.0",
  "info": {
    "title": "Mind OS Admin Intelligence Extensions API",
    "version": "1.0.0",
    "description": "Admin and intelligence extension actions for Mind OS. Keep separate from the stable daily Mind OS Action 1."
  },
  "servers": [
    {
      "url": "https://notebook-task-manager-admin.onrender.com"
    }
  ],
  "paths": {
    "/projects/update": {
      "post": {
        "operationId": "updateProject",
        "summary": "Update existing project metadata",
        "description": "Safely updates metadata for an existing project by exact project name. Does not create projects automatically and does not touch tasks, memories, or decisions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/memories/update": {
      "post": {
        "operationId": "updateMemory",
        "summary": "Update existing memory metadata",
        "description": "Safely updates metadata for an existing memory by exact memory_id. Does not create memories automatically and does not touch projects, tasks, or decisions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/decisions/update": {
      "post": {
        "operationId": "updateDecision",
        "summary": "Update existing decision metadata",
        "description": "Safely updates an existing decision by exact decision_id. Does not create decisions automatically and does not touch projects, tasks, or memories.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision update result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionUpdateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectUpdateRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Exact existing project name to update. Required."
          },
          "priority": {
            "type": "string",
            "description": "Optional project priority, for example High, Medium, Low."
          },
          "category": {
            "type": "string",
            "description": "Optional project category."
          },
          "description": {
            "type": "string",
            "description": "Optional project description."
          },
          "goal": {
            "type": "string",
            "description": "Optional project goal."
          },
          "tags": {
            "type": "string",
            "description": "Optional comma-separated tags."
          },
          "status": {
            "type": "string",
            "description": "Optional project status, for example Active, Paused, Completed."
          }
        },
        "additionalProperties": false
      },
      "ProjectResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectUpdateResponse": {
        "type": "object",
        "required": [
          "updated",
          "warnings"
        ],
        "properties": {
          "updated": {
            "type": "boolean",
            "description": "True only when an exact existing project was updated."
          },
          "project": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Warnings explaining blocked or partial updates."
          }
        }
      },
      "MemoryUpdateRequest": {
        "type": "object",
        "required": [
          "memory_id"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "description": "Exact existing memory ID to update. Required."
          },
          "memory_summary": {
            "type": "string",
            "description": "Optional updated memory summary."
          },
          "memory_type": {
            "type": "string",
            "description": "Optional memory type."
          },
          "entity": {
            "type": "string",
            "description": "Optional related entity."
          },
          "project": {
            "type": "string",
            "description": "Optional linked project name."
          },
          "tags": {
            "type": "string",
            "description": "Optional comma-separated tags."
          },
          "importance": {
            "type": "string",
            "description": "Optional importance level, for example High, Medium, Low."
          },
          "status": {
            "type": "string",
            "description": "Optional memory status, for example Active or Archived."
          }
        },
        "additionalProperties": false
      },
      "MemoryResponse": {
        "type": "object",
        "properties": {
          "memory_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity": {
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MemoryUpdateResponse": {
        "type": "object",
        "required": [
          "updated",
          "warnings"
        ],
        "properties": {
          "updated": {
            "type": "boolean",
            "description": "True only when an exact existing memory was updated."
          },
          "memory": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemoryResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Warnings explaining blocked or partial updates."
          }
        }
      },
      "DecisionUpdateRequest": {
        "type": "object",
        "required": [
          "decision_id"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "description": "Exact existing decision ID to update. Required."
          },
          "decision": {
            "type": "string",
            "description": "Optional updated decision text."
          },
          "context": {
            "type": "string",
            "description": "Optional decision context."
          },
          "rationale": {
            "type": "string",
            "description": "Optional decision rationale."
          },
          "outcome": {
            "type": "string",
            "description": "Optional decision outcome or follow-up result."
          },
          "tradeoffs": {
            "type": "string",
            "description": "Optional decision tradeoffs."
          },
          "project": {
            "type": "string",
            "description": "Optional linked project name."
          },
          "tags": {
            "type": "string",
            "description": "Optional comma-separated tags."
          },
          "status": {
            "type": "string",
            "description": "Optional decision status, for example Active, Follow-up, Resolved, Archived."
          },
          "importance": {
            "type": "string",
            "description": "Optional importance level, for example High, Medium, Low."
          }
        },
        "additionalProperties": false
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
