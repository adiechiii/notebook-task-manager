            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "importance": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "capture_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DecisionUpdateResponse": {
        "type": "object",
        "required": [
          "updated",
          "warnings"
        ],
        "properties": {
          "updated": {
            "type": "boolean",
            "description": "True only when an exact existing decision was updated."
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Warnings explaining blocked or partial updates."
          }
        }
      }
    }
  }
}
